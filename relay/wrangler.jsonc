{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "android-break-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-19",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
