<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      The agent holds no user data. The relay token lives in SharedPreferences on
      the device only, and this app is excluded from backup and transfer entirely.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
